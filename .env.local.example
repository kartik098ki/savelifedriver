# SAVIFE Server-side Environment Secrets
# NEVER expose secret API keys with NEXT_PUBLIC_ prefix

# AI Engine & Triage Telephony Agent
OPENAI_API_KEY=your_openai_api_key_here

# Hindi Text-to-Speech Engine
GNANI_API_KEY=your_gnani_tts_api_key_here

# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://savife_user:secure_password@localhost:5432/savife_db?schema=public

# Optional Map Providers (Defaults to built-in Leaflet + OSRM)
MAPS_API_KEY=your_google_maps_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
